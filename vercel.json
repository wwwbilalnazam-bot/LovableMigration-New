{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/migrate", "destination": "/app-shell.html" },
    { "source": "/oauth/:path*", "destination": "/app-shell.html" },
    { "source": "/github/:path*", "destination": "/app-shell.html" }
  ],
  "headers": [
    { "source": "/(migrate|oauth/(.*)|github/(.*))", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/og/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
