{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/migrate", "destination": "/app-shell" },
    { "source": "/oauth/:path*", "destination": "/app-shell" },
    { "source": "/github/:path*", "destination": "/app-shell" }
  ],
  "headers": [
    { "source": "/migrate", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/oauth/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/github/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/og/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
