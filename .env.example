# The Supabase project that hosts THIS app (waitlist, stats, migration-proxy function)
VITE_SUPABASE_URL=https://YOUR_APP_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-app-client-id
# GitHub App (public client id; secret is set on the proxy as GITHUB_CLIENT_SECRET)
VITE_GITHUB_CLIENT_ID=your-github-app-client-id
VITE_GITHUB_APP_SLUG=your-github-app-slug

# SEO / analytics (set these before building for production)
VITE_SITE_URL=https://your-domain.com
VITE_GA_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION=your-search-console-meta-tag-value
